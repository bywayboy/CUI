# ============================================================================
# CUI build (MSVC x64, 0CRT, Direct2D/DComp) - NMAKE incremental
#
# Entry point: build.cmd
#   build.cmd          incremental build
#   build.cmd clean    remove objects and binaries
#
# nmake recompiles only sources newer than their .obj. Every object also
# depends on all headers under src (build\headers.mk is generated by
# build.cmd), so a header change rebuilds everything. Changing this file
# (flags/link options) does the same.
#
# Keep this file ASCII-only: nmake interprets UTF-8 text in the local
# codepage and multibyte comments can break backslash continuations.
# ============================================================================

OBJ = build\obj
BIN = bin

CFLAGS = /nologo /c /std:c11 /O1 /Oi- /GS- /Gy /Gs32768 /W3 /utf-8 /wd4244 /wd4996 /DNO_CRT_NO_DEFAULTLIB /D_WIN32_WINNT=0x0A00 /DUNICODE /D_UNICODE /I. /Isrc /Isrc\ui /Isrc\gfx /Isrc\lib
CXXFLAGS = /nologo /c /std:c++17 /O1 /GS- /Gy /Gs32768 /W3 /utf-8 /wd4244 /wd4996 /EHs-c- /GR- /D_HAS_EXCEPTIONS=0 /DNO_CRT_NO_DEFAULTLIB /D_WIN32_WINNT=0x0A00 /DUNICODE /D_UNICODE /I. /Isrc /Isrc\ui /Isrc\gfx /Isrc\lib /Ibuild
LIBS = kernel32.lib user32.lib gdi32.lib d2d1.lib dwrite.lib d3d11.lib dxgi.lib dcomp.lib ole32.lib advapi32.lib shell32.lib imm32.lib winmm.lib ws2_32.lib secur32.lib crypt32.lib bcrypt.lib iphlpapi.lib windowscodecs.lib

LIBS_WIN = /nologo /SUBSYSTEM:WINDOWS /OPT:REF /OPT:ICF /NODEFAULTLIB /Brepro /ENTRY:startup /MANIFEST:NO
LIBS_CON = /nologo /SUBSYSTEM:CONSOLE /OPT:REF /OPT:ICF /NODEFAULTLIB /Brepro /ENTRY:startup /MANIFEST:NO

# Core objects, including gfx_d2d and the AVX2 memory functions.
CORE_OBJS = $(OBJ)\edit.obj $(OBJ)\log.obj $(OBJ)\crtstub.obj $(OBJ)\heap.obj \
    $(OBJ)\ui_anim.obj $(OBJ)\ui_context.obj $(OBJ)\ui_layout.obj \
    $(OBJ)\ui_grid.obj \
    $(OBJ)\ui_frame.obj $(OBJ)\ui_timer.obj $(OBJ)\ui_ime.obj \
    $(OBJ)\ui_paint.obj $(OBJ)\ui_theme.obj $(OBJ)\ui_widgets.obj \
    $(OBJ)\ui_icon.obj $(OBJ)\ui_popup.obj $(OBJ)\ui_tooltip.obj \
    $(OBJ)\ui_controls.obj $(OBJ)\ui_select.obj $(OBJ)\ui_menu.obj \
    $(OBJ)\ui_dialog.obj $(OBJ)\ui_textarea.obj $(OBJ)\ui_button_group.obj \
    $(OBJ)\ui_toast.obj $(OBJ)\ui_input.obj $(OBJ)\ui_app.obj \
    $(OBJ)\ui_progress.obj $(OBJ)\ui_scroll.obj $(OBJ)\ui_tab.obj \
    $(OBJ)\ui_nav.obj $(OBJ)\ui_pagination.obj $(OBJ)\ui_datetime.obj \
    $(OBJ)\ui_datepicker.obj \
    $(OBJ)\ui_image.obj $(OBJ)\net_base.obj $(OBJ)\net_tcp.obj \
    $(OBJ)\net_dns.obj $(OBJ)\net_tls.obj $(OBJ)\net_http.obj \
    $(OBJ)\net_ws.obj $(OBJ)\ui_net.obj $(OBJ)\net_ws_server.obj \
    $(OBJ)\net_tls_server.obj $(OBJ)\gfx_d2d.obj $(OBJ)\mem_avx2.obj

# Optional modules: linked only into targets that use rich text / Markdown.
OPT_OBJS = $(OBJ)\gfx_rich.obj $(OBJ)\gfx_math.obj $(OBJ)\ui_md_parse.obj \
    $(OBJ)\ui_md.obj $(OBJ)\md_math.obj

# Theme token tooling: linked only into the editor and its headless test.
THEME_EDIT_OBJS = $(OBJ)\ui_theme_edit.obj

SAMPLE_OBJS = $(OBJ)\demo.obj $(OBJ)\minimal.obj $(OBJ)\advanced.obj \
    $(OBJ)\multiwindow.obj $(OBJ)\mvvm.obj $(OBJ)\scrollview.obj \
    $(OBJ)\tabs.obj $(OBJ)\icons.obj $(OBJ)\controls.obj \
    $(OBJ)\overlays.obj $(OBJ)\textarea.obj $(OBJ)\datepicker.obj \
    $(OBJ)\net.obj $(OBJ)\image.obj $(OBJ)\ws_server.obj $(OBJ)\nav.obj \
    $(OBJ)\pagination.obj $(OBJ)\markdown.obj $(OBJ)\theme_editor.obj \
    $(OBJ)\grid.obj $(OBJ)\gallery.obj $(OBJ)\gallery_docs.obj

TEST_OBJS = $(OBJ)\net_test.obj $(OBJ)\gfx_rich_test.obj $(OBJ)\md_test.obj \
    $(OBJ)\md_ui_test.obj $(OBJ)\md_math_test.obj $(OBJ)\gfx_math_test.obj \
    $(OBJ)\ui_nav_test.obj $(OBJ)\ui_pagination_test.obj \
    $(OBJ)\ui_layout_test.obj $(OBJ)\ui_grid_test.obj \
    $(OBJ)\ui_theme_edit_test.obj

TARGETS = $(BIN)\cui_demo.exe $(BIN)\cui_minimal.exe $(BIN)\cui_advanced.exe \
    $(BIN)\cui_multi.exe $(BIN)\cui_mvvm.exe $(BIN)\cui_scroll.exe \
    $(BIN)\cui_tabs.exe $(BIN)\cui_icons.exe $(BIN)\cui_controls.exe \
    $(BIN)\cui_overlays.exe $(BIN)\cui_textarea.exe $(BIN)\cui_datepicker.exe \
    $(BIN)\cui_net.exe $(BIN)\cui_net_test.exe $(BIN)\cui_image.exe \
    $(BIN)\cui_ws_server.exe $(BIN)\cui_gfx_rich_test.exe $(BIN)\cui_md_test.exe \
    $(BIN)\cui_md_ui_test.exe $(BIN)\cui_md_math_test.exe \
    $(BIN)\cui_gfx_math_test.exe $(BIN)\cui_markdown.exe $(BIN)\cui_nav.exe \
    $(BIN)\cui_nav_test.exe $(BIN)\cui_pagination.exe \
    $(BIN)\cui_pagination_test.exe $(BIN)\cui_layout_test.exe \
    $(BIN)\cui_grid.exe $(BIN)\cui_grid_test.exe \
    $(BIN)\cui_theme_editor.exe \
    $(BIN)\cui_theme_edit_test.exe \
    $(BIN)\cui_gallery.exe

# Generated by build.cmd: HEADERS = all .h/.hpp under src.
!IF EXIST("build\headers.mk")
!INCLUDE build\headers.mk
!ENDIF

all: $(TARGETS)

# Rebuild every object when any header or this makefile changes.
COMPILED_OBJS = $(CORE_OBJS) $(OPT_OBJS) $(THEME_EDIT_OBJS) \
    $(SAMPLE_OBJS) $(TEST_OBJS)
$(COMPILED_OBJS): $(HEADERS) build.mk

# Custom D2D effect shader: compiled offline into a byte array.
# FXC is passed on the nmake command line by build.cmd.
build\grain_cso.h: src\gfx\grain.hlsl
	@"$(FXC)" /nologo /T ps_4_0 /E main /Fh $@ /Vn g_grainCso $**
	@echo [cui] src\gfx\grain.hlsl

$(OBJ)\gfx_d2d.obj: src\gfx\gfx_d2d.cpp build\grain_cso.h $(HEADERS) build.mk
	@echo [cui] src\gfx\gfx_d2d.cpp
	@cl $(CXXFLAGS) src\gfx\gfx_d2d.cpp /Fo$@

$(OBJ)\mem_avx2.obj: src\lib\mem_avx2.c $(HEADERS) build.mk
	@echo [cui] src\lib\mem_avx2.c (AVX2)
	@cl $(CFLAGS) /arch:AVX2 src\lib\mem_avx2.c /Fo$@

# Inference rules: source directory -> flat object directory.
{src}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{src\ui}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{src\lib}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{src\net}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{src\gfx}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{src\gfx}.cpp{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CXXFLAGS) $< /Fo$@

{samples}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

{tests}.c{$(OBJ)}.obj:
	@echo [cui] $<
	@cl $(CFLAGS) $< /Fo$@

