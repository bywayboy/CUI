clean:
	@-del /q $(OBJ)\*.obj $(OBJ)\*.json 2>NUL
	@-del /q build\headers.mk build\grain_cso.h 2>NUL
	@-del /q $(TARGETS) 2>NUL
	@echo [cui] cleaned
